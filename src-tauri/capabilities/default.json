{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Vibeking main + chip bar capabilities",
  "windows": ["main", "chipbar", "modepicker"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "opener:default",
    "clipboard-manager:default",
    "store:default",
    "os:default",
    "log:default",
    {
      "identifier": "sql:default",
      "allow": [
        { "name": "sqlite:vibeking.db" }
      ]
    },
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select"
  ]
}
